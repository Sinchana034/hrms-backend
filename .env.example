# Supabase project (staging or production — see Section 21, two isolated envs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend-only, never sent to frontend
SUPABASE_JWT_SECRET=your-jwt-secret                # for verifying HR auth tokens

# CAPTCHA (Section 6.1 spam/abuse protection) — Turnstile or reCAPTCHA v3
CAPTCHA_PROVIDER=turnstile        # turnstile | recaptcha_v3 | none (staging only)
CAPTCHA_SECRET_KEY=your-captcha-secret


# Resume storage (Section 14 — private Supabase Storage bucket, signed URLs only)
RESUME_STORAGE_BUCKET=resumes
RESUME_MAX_SIZE_MB=5
RESUME_SIGNED_URL_TTL_SECONDS=600


# App
ENVIRONMENT=staging                # staging | production
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_APPLICATIONS_PER_IP=5/minute
RATE_LIMIT_APPLICATIONS_PER_EMAIL=3/hour


# Phase 2 — email ingestion (Section 6.2). Provider choice is still an open
# decision (Section 27); leave EMAIL_SYNC_PROVIDER=none to skip entirely.
EMAIL_SYNC_PROVIDER=none          # gmail | outlook | none
ENCRYPTION_KEY=                   # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/email-sync/gmail/callback
FRONTEND_URL=http://localhost:5173
OAUTH_STATE_SECRET=                # optional — falls back to SUPABASE_JWT_SECRET

# Phase 2 — duplicate detection (Section 6.3)
DUPLICATE_FUZZY_NAME_THRESHOLD=90

# Phase 2 — bounce/complaint webhook (Section 10)
SENDGRID_WEBHOOK_VERIFICATION_KEY=  # optional shared secret, sent as X-Webhook-Secret header


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
